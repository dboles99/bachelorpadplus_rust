; BachelorPad+ per-user installer (release plan M3-01, decision 18, ADR-0032).
;
; Build it with Build-Installer.ps1, which reads the version from Cargo.toml
; and passes every /D switch this script requires. Needs Inno Setup 6.3 or
; later (x64compatible).
;
; Two blocks below are generated by bp-platform and must not be edited by
; hand: the [Registry] entries, from bp_platform::editor::windows::
; registry_values, and the user's directories in [Code], from
; bp_platform::dirs. Change crates/bp-platform/src/editor/inno.rs and run
;   cargo run -p bp-platform --example regenerate_windows_installer
; crates/bp-platform/tests/windows_installer.rs fails if either block differs
; from the generator by a byte.
;
; This file is kept to ASCII (a test holds it to that), so ISCC reads it the
; same way whatever code page the build machine uses.

#ifndef AppVersion
  #error Pass /DAppVersion=<the version in Cargo.toml>. Build-Installer.ps1 does.
#endif
#ifndef AppVersionNumeric
  #error Pass /DAppVersionNumeric=<major.minor.patch.0>. Build-Installer.ps1 does.
#endif
#ifndef SourceExe
  #error Pass /DSourceExe=<path to the release bachelorpad.exe>. Build-Installer.ps1 does.
#endif
#ifndef LicenceFile
  #error Pass /DLicenceFile=<the combined licence text>. Build-Installer.ps1 writes it.
#endif
#ifndef RepoRoot
  #define RepoRoot AddBackslash(SourcePath) + "..\.."
#endif
; Build-Installer.ps1 passes a copy with CRLF line endings, whatever the
; checkout did to the one in the tree.
#ifndef BpadCmd
  #define BpadCmd RepoRoot + "\packaging\windows\bpad.cmd"
#endif

[Setup]
; Fixed for the life of the product: Windows finds an earlier install, and
; its uninstaller, by this id. Never change it.
AppId={{97D93154-2AAB-4EA8-BAB8-43B7869AA059}
AppName=BachelorPad+
AppVersion={#AppVersion}
AppVerName=BachelorPad+ {#AppVersion}
AppPublisher=Daniel Boles
AppCopyright=Copyright (C) Daniel Boles
VersionInfoVersion={#AppVersionNumeric}
VersionInfoProductName=BachelorPad+
VersionInfoProductTextVersion={#AppVersion}
VersionInfoDescription=BachelorPad+ Setup
; Per-user, with no way to ask for more. Registration is HKCU only
; (ADR-0032), and an override would let the same installer run elevated and
; land somewhere the generated entries were never meant for.
PrivilegesRequired=lowest
DefaultDirName={localappdata}\Programs\BachelorPad+
DisableProgramGroupPage=yes
; Makes Setup and the uninstaller send SHChangeNotify(SHCNE_ASSOCCHANGED), so
; Explorer picks up the registration, and its removal, without a sign-out.
ChangesAssociations=yes
; Broadcasts WM_SETTINGCHANGE after the optional PATH change below.
ChangesEnvironment=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
SetupIconFile={#RepoRoot}\assets\icon\bachelorpad.ico
UninstallDisplayIcon={app}\bachelorpad.exe
LicenseFile={#LicenceFile}
WizardStyle=modern
Compression=lzma2
SolidCompression=yes
; Both overridden by Build-Installer.ps1 (ISCC /O and /F).
OutputDir=Output
OutputBaseFilename=BachelorPadPlus-{#AppVersion}-windows-x64-setup

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
; Unchecked: PATH is shared by every program the user runs, so adding to it
; is asked for, not assumed. bpad.cmd is installed either way.
Name: "addtopath"; Description: "Add the bpad command to PATH for this user"; GroupDescription: "Command line:"; Flags: unchecked

[Files]
Source: "{#SourceExe}"; DestDir: "{app}"; DestName: "bachelorpad.exe"; Flags: ignoreversion
Source: "{#BpadCmd}"; DestDir: "{app}"; DestName: "bpad.cmd"; Flags: ignoreversion
Source: "{#RepoRoot}\LICENSE-MIT"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#RepoRoot}\LICENSE-APACHE"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\BachelorPad+"; Filename: "{app}\bachelorpad.exe"
Name: "{autodesktop}\BachelorPad+"; Filename: "{app}\bachelorpad.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\bachelorpad.exe"; Description: "{cm:LaunchProgram,BachelorPad+}"; Flags: nowait postinstall skipifsilent

[Registry]
