[Code]
// BEGIN GENERATED user-directories: cargo run -p bp-platform --example regenerate_windows_installer
const
  ConfigDirectory = '{userappdata}\bachelorpad';
  DataDirectory = '{localappdata}\bachelorpad\data';
  CacheDirectory = '{localappdata}\bachelorpad\cache';
  StateDirectory = '{localappdata}\bachelorpad\state';
  ProductLocalDirectory = '{localappdata}\bachelorpad';
// END GENERATED user-directories

const
  EnvironmentKey = 'Environment';
  PathValue = 'Path';

// The comparison Windows itself makes between PATH entries: case-insensitive,
// and blind to surrounding spaces and a trailing backslash.
function SamePathEntry(const A, B: String): Boolean;
begin
  Result := CompareText(RemoveBackslashUnlessRoot(Trim(A)),
    RemoveBackslashUnlessRoot(Trim(B))) = 0;
end;

// Path with every entry equal to Dir taken out. Every other entry, empty
// ones included, is kept exactly as it was and in the same order, so that
// removing our entry cannot rewrite anybody else's.
function WithoutEntry(const Path, Dir: String): String;
var
  Rest, Entry: String;
  Separator: Integer;
  Done, First: Boolean;
begin
  Result := '';
  Rest := Path;
  First := True;
  Done := False;
  while not Done do
  begin
    Separator := Pos(';', Rest);
    if Separator = 0 then
    begin
      Entry := Rest;
      Done := True;
    end
    else
    begin
      Entry := Copy(Rest, 1, Separator - 1);
      Delete(Rest, 1, Separator);
    end;
    if not SamePathEntry(Entry, Dir) then
    begin
      if not First then
        Result := Result + ';';
      Result := Result + Entry;
      First := False;
    end;
  end;
end;

// REG_EXPAND_SZ, as Windows writes the user PATH itself, so entries such as
// %USERPROFILE%\bin read back unexpanded keep working.
procedure AddToUserPath(const Dir: String);
var
  Path: String;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, EnvironmentKey, PathValue, Path) then
    Path := '';
  if WithoutEntry(Path, Dir) <> Path then
    Exit;
  if (Path <> '') and (Path[Length(Path)] <> ';') then
    Path := Path + ';';
  if not RegWriteExpandStringValue(HKEY_CURRENT_USER, EnvironmentKey, PathValue, Path + Dir) then
    Log('Could not add ' + Dir + ' to the user PATH.');
end;

procedure RemoveFromUserPath(const Dir: String);
var
  Path, Kept: String;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, EnvironmentKey, PathValue, Path) then
    Exit;
  Kept := WithoutEntry(Path, Dir);
  if Kept = Path then
    Exit;
  // Only our entry was there, so the value was ours too.
  if Kept = '' then
    RegDeleteValue(HKEY_CURRENT_USER, EnvironmentKey, PathValue)
  else if not RegWriteExpandStringValue(HKEY_CURRENT_USER, EnvironmentKey, PathValue, Kept) then
    Log('Could not remove ' + Dir + ' from the user PATH.');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  // The task's state is the truth on every install, so re-running Setup
  // with the box cleared takes the entry away again.
  if CurStep = ssPostInstall then
  begin
    if WizardIsTaskSelected('addtopath') then
      AddToUserPath(ExpandConstant('{app}'))
    else
      RemoveFromUserPath(ExpandConstant('{app}'));
  end;
end;

procedure AddIfPresent(var Found: String; const Directory: String);
begin
  if DirExists(ExpandConstant(Directory)) then
    Found := Found + #13#10 + '    ' + ExpandConstant(Directory);
end;

// Asks, with No as the default, before deleting the three local
// directories: the recovery journal (unsaved work) and the Sign Document
// key are in them, and neither can be made again. The configuration
// directory is never deleted: it roams with the Windows profile (ADR-0029),
// so it may belong to a copy still installed on another computer.
procedure OfferToDeleteLocalData;
var
  Found: String;
begin
  Found := '';
  AddIfPresent(Found, DataDirectory);
  AddIfPresent(Found, StateDirectory);
  AddIfPresent(Found, CacheDirectory);
  if Found = '' then
    Exit;
  if SuppressibleMsgBox(
      'Also delete the BachelorPad+ data kept on this computer?' + #13#10 + Found + #13#10 + #13#10 +
      'This includes the recovery journal (any unsaved work), the key Sign Document uses, ' +
      'the recent-files list and the security history. It cannot be undone.' + #13#10 + #13#10 +
      'Your settings in ' + ExpandConstant(ConfigDirectory) + ' are kept either way, because ' +
      'they roam with your Windows profile.',
      mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) <> IDYES then
    Exit;
  DelTree(ExpandConstant(DataDirectory), True, True, True);
  DelTree(ExpandConstant(StateDirectory), True, True, True);
  DelTree(ExpandConstant(CacheDirectory), True, True, True);
  // RemoveDir removes only an empty directory, so anything else in it stays.
  RemoveDir(ExpandConstant(ProductLocalDirectory));
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
    RemoveFromUserPath(ExpandConstant('{app}'));
  // A silent uninstall has nobody to ask, and nobody has agreed to lose
  // anything, so the user's data stays.
  if (CurUninstallStep = usPostUninstall) and not UninstallSilent then
    OfferToDeleteLocalData;
end;
