// The status bar (specs.md section 3).
//
// Two rows: what the document is, and where it is. The second row doubles as
// the error line, because an error about the open document belongs next to the
// document's path rather than in a dialog the user has to dismiss.

import { Palette } from "types.slint";

component StatusText inherits Text {
    color: Palette.ink-dim;
    font-size: 12px;
    vertical-alignment: center;
}

export component StatusBar inherits Rectangle {
    in property <string> save-state;
    in property <bool> is-dirty;
    in property <string> format-label;
    in property <string> encoding-label;
    in property <string> line-ending-label;
    in property <string> cursor-label;
    in property <string> theme-name;
    /// The active document's security profile, or empty under the default.
    ///
    /// Shown only when it is not Standard: a permanent "Standard" would be
    /// noise on every document, and the whole value of the readout is that
    /// something *unusual* is in force.
    in property <string> security-label;
    in property <string> location;
    in property <string> error-message;

    /// What the path and notice segments are showing, for the window tests.
    out property <string> shown-path: path-text.text;
    out property <string> shown-notice: notice-text.visible ? notice-text.text : "";

    callback cycle-theme();

    height: 44px;
    background: Palette.panel;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Text {
                text: root.save-state;
                // Dirty is the state worth noticing, so it gets
                // the accent; a clean save is unremarkable.
                color: root.is-dirty ? Palette.accent : Palette.ink-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            StatusText { text: "│ " + root.format-label; }
            StatusText { text: "│ " + root.encoding-label; }
            StatusText { text: "│ " + root.line-ending-label; }
            StatusText { text: "│ " + root.cursor-label; }
            // In the accent, like the theme name and the dirty marker: it
            // only appears when it has something to say, and when it does it
            // is a statement about where this document's data may go.
            if root.security-label != "": Text {
                text: "│ " + root.security-label;
                color: Palette.accent;
                font-size: 12px;
                vertical-alignment: center;
            }

            Rectangle {
                width: theme-label.preferred-width + 16px;
                background: theme-area.has-hover ? Palette.edge : transparent;
                theme-label := Text {
                    text: "│ " + root.theme-name;
                    color: Palette.accent;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                theme-area := TouchArea {
                    clicked => {
                        root.cycle-theme();
                    }
                }
            }
        }

        // The path and a notice side by side, never one instead of the
        // other (locked decision #5, release plan M1-16). This line used to
        // show the notice *in place of* the path, so any message -- "saved",
        // a warning from a minute ago -- hid where the document lives, which
        // is the one thing the status bar promises always to say.
        HorizontalLayout {
            spacing: 12px;

            path-text := Text {
                text: root.location;
                color: Palette.ink-dim;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 120px;
            }
            notice-text := Text {
                text: root.error-message;
                visible: root.error-message != "";
                color: Palette.accent;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: right;
                // Under half the line, so a long notice elides before the
                // path has to. Slint elides only at the end, so a squeezed
                // path loses its file name first -- which the tab strip and
                // the title bar still show; the folder is shown nowhere else.
                max-width: root.width * 0.45;
            }
        }
    }
}
