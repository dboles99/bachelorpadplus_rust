// The menu primitives: a bar label, a row, and the popup that holds rows.
//
// `MenuLabel` is not only used by the menu bar. It is the shell's general
// clickable-label shape, so the find bar's arrows and the panel close buttons
// use it too -- one hover treatment everywhere rather than three that drift.

import { MenuItem, Palette } from "types.slint";

/// Keyboard movement through a menu's rows, answered in Rust
/// (`menus::next_live_row`), where it is unit-tested.
export global MenuNav {
    /// The next row from `from` in direction `delta` that is enabled,
    /// wrapping; `from` itself if none is, and -1 for an empty menu.
    pure callback next([MenuItem], int, int) -> int;
}

export component MenuLabel inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    /// False takes the label off the bar. Zero wide rather than inside an
    /// `if`, because each menu popup is placed from its label's `x`, and an
    /// element inside an `if` cannot be named from outside it.
    in property <bool> shown: true;
    callback clicked();
    height: 26px;
    width: root.shown ? txt.preferred-width + 22px : 0px;
    visible: root.shown;
    background: root.open || ta.has-hover ? Palette.edge : transparent;

    // A screen reader hears "File, button, collapsed" rather than nothing:
    // Slint 1.17 has no menu roles, and a button that expands is the
    // nearest honest description (release plan M2-14).
    accessible-role: button;
    accessible-label: root.label;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => {
        root.clicked();
    }

    txt := Text {
        text: root.label;
        color: Palette.ink;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component MenuRow inherits Rectangle {
    in property <MenuItem> item;
    /// Where the keyboard is. Drawn like the pointer's hover, so the two
    /// never disagree about what Enter would choose.
    in property <bool> highlighted;
    callback chosen(int);
    height: 28px;
    background: root.item.enabled && (ta.has-hover || root.highlighted) ? Palette.edge : Palette.panel;

    accessible-role: list-item;
    accessible-label: root.item.label;
    accessible-description: root.item.shortcut;
    accessible-enabled: root.item.enabled;
    accessible-item-selected: root.highlighted;
    accessible-action-default => {
        if (root.item.enabled) {
            root.chosen(root.item.action);
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 24px;

        Text {
            text: root.item.label;
            // Greyed when inert, so "not implemented" is visible rather than
            // discovered by clicking.
            color: root.item.enabled ? Palette.ink : Palette.ink-dim;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.item.shortcut;
            color: Palette.ink-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            if (root.item.enabled) {
                root.chosen(root.item.action);
            }
        }
    }
}

export component MenuPopup inherits PopupWindow {
    in property <[MenuItem]> items;
    in property <length> menu-width: 280px;
    /// How tall this menu may grow before its rows start scrolling.
    ///
    /// Not cosmetic, and not a guess at a nice size. A menu's height here is
    /// user data rather than a constant: the Edit menu is built from
    /// clipboard history, one row per entry plus up to three for the
    /// transformations it offers, so at `bp_clipboard::MAX_ENTRIES` it asks
    /// for over a hundred rows. Binding straight to `content.preferred-height`
    /// makes the rows past the window's bottom edge unreachable -- there is
    /// nothing to drag and nothing to scroll -- and the rows that go first are
    /// the ones at the bottom. Five copied clips were enough to put every line
    /// operation out of reach, five of which have no keyboard shortcut.
    ///
    /// Named like `menu-width` for the same reason: `max-height` is a builtin
    /// layout property and cannot be redeclared.
    in property <length> menu-max-height: 400px;
    /// The row the keyboard is on, or -1 for none.
    in-out property <int> highlighted: -1;
    callback chosen(int);
    /// Left (-1) or Right (+1) asked for the neighbouring menu.
    callback neighbour(int);
    /// Escape closed the menu from the keyboard.
    callback dismissed();

    /// Move the highlight `delta` rows, skipping readouts and greyed rows,
    /// and wrapping. Stays put if there is no live row at all. The search is
    /// Rust's (`MenuNav.next`): Slint has no loops.
    function step(delta: int) {
        root.highlighted = MenuNav.next(root.items, root.highlighted, delta);
    }

    width: root.menu-width;
    height: min(content.preferred-height, root.menu-max-height);

    // A popup is built afresh each time it is shown, and nothing outside
    // it can call into it (it is a window of its own), so it takes the
    // keyboard itself: opened by F10, a mnemonic, Left/Right or a click,
    // the arrows and Enter work straight away, starting from the first
    // live row.
    keys := FocusScope {
        init => {
            root.highlighted = -1;
            root.step(1);
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.step(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.step(-1);
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                if (root.highlighted >= 0 && root.highlighted < root.items.length
                        && root.items[root.highlighted].enabled) {
                    root.close();
                    root.chosen(root.items[root.highlighted].action);
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                root.close();
                root.dismissed();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.close();
                root.neighbour(-1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.close();
                root.neighbour(1);
                return accept;
            }
            reject
        }
    }

    Rectangle {
        background: Palette.panel;
        border-color: Palette.edge;
        border-width: 1px;
        accessible-role: list;

        Flickable {
            // Both viewport dimensions are set. Height is the point of the
            // exercise, but width has to be pinned to the visible width or the
            // viewport sizes itself to the content's preferred width instead
            // -- and a recent-files hint is far wider than the menu. Every row
            // would then be laid out over-wide, putting the shortcut column
            // past the right edge, where a Flickable clips it. Before this was
            // a Flickable that text simply overflowed the popup and drew
            // outside it, so nothing was lost; now it would be.
            viewport-width: self.width;
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                alignment: start;
                padding: 4px;
                for item[i] in root.items: VerticalLayout {
                    MenuRow {
                        item: item;
                        highlighted: i == root.highlighted;
                        chosen(action) => {
                            root.chosen(action);
                        }
                    }

                    if item.separator-after: Rectangle {
                        height: 5px;
                        Rectangle {
                            height: 1px;
                            y: 2px;
                            background: Palette.edge;
                        }
                    }
                }
            }
        }
    }
}
